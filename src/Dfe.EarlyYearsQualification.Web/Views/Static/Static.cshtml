@model Dfe.EarlyYearsQualification.Web.Models.Content.StaticPageModel

@{
    ViewData["Title"] = Model.Heading;
    ViewData["OpenGraph"] = Model.OpenGraphData;
    ViewData["Indexable"] = Model.IsIndexable;
    ViewData["HasBackToTop"] = Model.BackToTopButton is not null;
}

@section BeforeMainContent {
    @{
        await Html.RenderPartialAsync("Partials/BackButton", Model.BackButton);
    }
}

@section AfterMainContent {
    @if (Model.BackToTopButton is not null)
    {
        await Html.RenderPartialAsync("Partials/BackToTop", Model.BackToTopButton);
    }
}

@{
    await Html.RenderPartialAsync("Partials/BaseStaticPage", Model);
}